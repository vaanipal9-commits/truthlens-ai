# =============================================================================
# TruthLens AI — Environment Variables
# =============================================================================
# 1. Copy this file to `.env`   (cp .env.example .env)
# 2. Fill in your real GROQ_API_KEY below
# 3. Run `npm install && npm run dev` from the project root
#
# NEVER commit your real .env file. It is git-ignored by default.
# NEVER prefix a secret with VITE_ — that would expose it to the browser.
# =============================================================================

# ---- REQUIRED ---------------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=YOUR_REAL_GROQ_API_KEY_HERE

# ---- OPTIONAL ---------------------------------------------------------------
# TruthLens uses Groq's built-in Compound web search by default (no extra key).
# If you prefer Tavily as the live-search provider, add your key below.
# Get a key at https://tavily.com
TAVILY_API_KEY=

# ---- FRONTEND ---------------------------------------------------------------
# This is safe to expose to the browser (it's just a URL, not a secret).
VITE_API_URL=http://localhost:5000

# ---- SERVER -----------------------------------------------------------------
PORT=5000
